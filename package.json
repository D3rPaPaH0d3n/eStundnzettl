{
  "name": "eStundnzettl",
  "private": true,
  "version": "4.3.0",
  "type": "module",
  "description": "Elektronischer Stundenzettel — smarte Zeiterfassung aus der Steiermark (Ionic/Capacitor App).",
  "license": "MIT",
  "author": {
    "name": "Markus Kainer",
    "email": "project@kainer.co.at",
    "url": "https://d3rpapah0d3n.github.io/eStundnzettl/"
  },
  "homepage": "https://d3rpapah0d3n.github.io/eStundnzettl/",
  "repository": {
    "type": "git",
    "url": "https://github.com/D3rPaPaH0d3n/eStundnzettl.git"
  },
  "bugs": {
    "url": "https://github.com/D3rPaPaH0d3n/eStundnzettl/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx,ts,tsx --report-unused-disable-directives",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true vite build",
    "knip": "knip",
    "postinstall": "npx replace-in-files-cli --string=\"proguard-android.txt\" --replacement=\"proguard-android-optimize.txt\" \"node_modules/@capacitor/*/android/build.gradle\" \"node_modules/@capgo/*/android/build.gradle\" \"node_modules/@capacitor-community/*/android/build.gradle\"",
    "cap:open": "npx cap open android",
    "version": "node scripts/sync-version.js",
    "release:patch": "node scripts/confirm-release.js && npm version patch && git push && git push --tags && npm run build && npx cap sync && npx cap open android",
    "release:minor": "node scripts/confirm-release.js && npm version minor && git push && git push --tags && npm run build && npx cap sync && npx cap open android",
    "release:major": "node scripts/confirm-release.js && npm version major && git push && git push --tags && npm run build && npx cap sync && npx cap open android",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor-community/date-picker": "^7.1.0",
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.3.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capgo/capacitor-social-login": "^8.3.11",
    "@fontsource/roboto": "^5.2.10",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/react": "^10.47.0",
    "@tailwindcss/vite": "^4.2.2",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "i18next": "^26.0.3",
    "lucide-react": "^1.7.0",
    "pako": "^2.1.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.4",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "knip": "^6.3.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.8",
    "replace-in-files-cli": "^4.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.2.2",
    "terser": "^5.46.1",
    "typescript": "^6.0.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored"
    ]
  },
  "overrides": {
    "brace-expansion": "^1.1.13"
  }
}
