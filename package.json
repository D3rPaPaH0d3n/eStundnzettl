{
  "name": "eStundnzettl",
  "private": true,
  "version": "4.5.2",
  "type": "module",
  "description": "Elektronischer Stundenzettel — smarte Zeiterfassung aus der Steiermark (Ionic/Capacitor App).",
  "license": "MIT",
  "author": {
    "name": "Markus Kainer",
    "email": "project@kainer.co.at",
    "url": "https://kainer.co.at/projekte/estundnzettl/"
  },
  "homepage": "https://kainer.co.at/projekte/estundnzettl/",
  "repository": {
    "type": "git",
    "url": "https://github.com/D3rPaPaH0d3n/eStundnzettl.git"
  },
  "bugs": {
    "url": "https://github.com/D3rPaPaH0d3n/eStundnzettl/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx,ts,tsx --report-unused-disable-directives",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true vite build",
    "knip": "knip",
    "postinstall": "npx replace-in-files-cli --string=\"proguard-android.txt\" --replacement=\"proguard-android-optimize.txt\" \"node_modules/@capacitor/*/android/build.gradle\" \"node_modules/@capgo/*/android/build.gradle\" \"node_modules/@capacitor-community/*/android/build.gradle\" \"node_modules/capacitor-secure-storage-plugin/android/build.gradle\"",
    "cap:open": "npx cap open android",
    "version": "node scripts/sync-version.js",
    "release:patch": "node scripts/confirm-release.js && npm version patch && npm run verify:release && git push && git push --tags && npx cap open android",
    "release:minor": "node scripts/confirm-release.js && npm version minor && npm run verify:release && git push && git push --tags && npx cap open android",
    "release:major": "node scripts/confirm-release.js && npm version major && npm run verify:release && git push && git push --tags && npx cap open android",
    "prepare": "husky",
    "verify:release": "npm run lint && npm run typecheck && npm test && npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-social-login": "^8.5.11",
    "@fontsource/roboto": "^5.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/react": "^10.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "framer-motion": "^12.42.2",
    "i18next": "^26.4.2",
    "lucide-react": "^1.48.0",
    "pako": "^2.1.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^17.0.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "replace-in-files-cli": "^4.0.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.2.2",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored"
    ]
  },
  "overrides": {
    "brace-expansion": "^1.1.13"
  }
}
