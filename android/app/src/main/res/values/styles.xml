<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">#020617</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">#020617</item>
    </style>

    <!-- Custom TimePicker Theme: Dark + Emerald Accent -->
    <style name="eStundnzettlTimePicker" parent="@android:style/Theme.DeviceDefault.Dialog">
        <item name="android:colorAccent">#10B981</item>
        <item name="android:colorControlActivated">#10B981</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#A1A1AA</item>
        <item name="android:windowBackground">#18181B</item>
        <item name="android:colorBackground">#18181B</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/eStundnzettlPositiveButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/eStundnzettlNegativeButton</item>
    </style>

    <style name="eStundnzettlPositiveButton" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:textColor">#10B981</item>
    </style>

    <style name="eStundnzettlNegativeButton" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:textColor">#A1A1AA</item>
    </style>

</resources>